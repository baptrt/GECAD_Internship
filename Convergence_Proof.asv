% === Paramètres ===
csv_file_tradi = 'T_0_final_evolution.csv';  
csv_file_multi = 'Multi_Agents_Peak/T_final_evolution.csv'
pairs_to_plot = [0 1; 1 2; 0 2];     
n_agents = 3;                          
% === Lecture du fichier CSV ===
T = readtable(csv_file);

iterations = T.Iteration;

% === Tracé des échanges T_0(i,j) ===
figure;
hold on;

for k = 1:size(pairs_to_plot, 1)
    i = pairs_to_plot(k, 1);
    j = pairs_to_plot(k, 2);
    col_name = sprintf('T_0_%d_%d', i, j);
    
    if any(strcmp(T.Properties.VariableNames, col_name))
        plot(iterations, T.(col_name), 'DisplayName', sprintf('T_{0}(%d→%d)', i, j));
    else
        warning('Colonne %s non trouvée dans le fichier.', col_name);
    end
end

xlabel('Itération');
ylabel('Échange T_{ij}');
title('Évolution des échanges d''énergie T_{0}(i \rightarrow j)');
legend('show');
grid on;
