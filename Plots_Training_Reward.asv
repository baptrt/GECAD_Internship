% This script loads two CSV files and plots the "Reward" over "Training steps"
% including a moving average (window = 50) for both.

clc;
clear;

% Prompt user to select two CSV files
[file1, path1] = uigetfile('.csv', '');
[file2, path2] = uigetfile('.csv', '');

% Load the CSV data
data1 = readtable(fullfile(path1, file1));
data2 = readtable(fullfile(path2, file2));

% Extract "Training steps" and "Reward" columns
steps1 = data1.("Training steps");
reward1 = data1.Reward;

steps2 = data2.("Training steps");
reward2 = data2.Reward;

% Compute moving averages (window = 50)
window = 50;
reward1_avg = movmean(reward1, window);
reward2_avg = movmean(reward2, window);

% Plotting
figure;
hold on;
plot(steps1, reward1, 'Color', [0.2 0.6 1.0], 'DisplayName', 'Reward - File 1');
plot(steps1, reward1_avg, 'Color', [0 0 0.5], 'LineWidth', 2, 'DisplayName', 'Moving Avg - File 1');
plot(steps2, reward2, 'Color', [1.0 0.4 0.4], 'DisplayName', 'Reward - File 2');
plot(steps2, reward2_avg, 'Color', [0.5 0 0], 'LineWidth', 2, 'DisplayName', 'Moving Avg - File 2');

% Figure settings
xlabel('Training steps');
ylabel('Reward');
title('Reward vs Training steps with Moving Average (window = 50)');
legend('Location', 'best');
grid on;
hold off;
